# Copia este archivo a .env.local y rellena los valores de tu proyecto de Supabase.
# Solo claves PÚBLICAS: nunca pongas aquí la service_role ni el token del bot de Discord.
NEXT_PUBLIC_SUPABASE_URL=https://<tu-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: enlace público de instalación de la app de Discord (Portal → Installation → Install Link).
NEXT_PUBLIC_DISCORD_INSTALL_URL=
